# GST Filing Platform — Environment Configuration (.env.example)
# Phase 5: Deployment, Compliance & Go-Live (Free/OSS-only)

# App Core
GST_DEV_MODE=true
GST_JWT_SECRET=change-me-in-production-secure-secret

# MinIO Object Storage
GST_MINIO_ENDPOINT=127.0.0.1:9001
GST_MINIO_USE_TLS=false
GST_MINIO_ACCESS_KEY=gst_admin
GST_MINIO_SECRET_KEY=gst_minio_dev_pass

# Redis
GST_REDIS_URL=redis://127.0.0.1:6380/0

# Extraction LLM
GST_EXTRACTION_LLM_BASE_URL=http://127.0.0.1:3001/v1
GST_EXTRACTION_LLM_MODEL=llama3.1:8b

# GSP (Goods and Services Tax Portal Sandbox) Developer Tier Credentials
GST_GSP_CLIENT_ID=dev-client-id
GST_GSP_CLIENT_SECRET=dev-client-secret
GST_GSP_USERNAME=dev-username
GST_GSP_PASSWORD=dev-password
GST_GSP_SANDBOX_MODE=true
GST_GSP_API_BASE_URL=https://sandbox.gst.gov.in

# IRP (Invoice Registration Portal Sandbox / Trial) Developer Tier Credentials
GST_IRP_CLIENT_ID=dev-client-id
GST_IRP_CLIENT_SECRET=dev-client-secret
GST_IRP_USERNAME=dev-username
GST_IRP_PASSWORD=dev-password
GST_IRP_SANDBOX_MODE=true
GST_IRP_API_BASE_URL=https://einvoice1-trial.nic.in
